# ==========================================
# Enterprise Reporting System
# Production Environment for Hostinger VPS
# ==========================================
# Copy this file to .env and update values:
#   cp .env.docker.production .env
#   nano .env
# ==========================================

# Application URL (update with your domain or VPS IP)
NEXT_PUBLIC_APP_URL=https://your-domain.com
APP_PORT=3000

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
AUTH_URL=https://your-domain.com

# Redis Configuration
# Generate a strong password with: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
REDIS_PORT=6379

# Encryption key for data source credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Job Processing
MAX_CONCURRENT_JOBS=5

# Data storage path on VPS filesystem
DATA_PATH=/srv/enterprise-reporting-system

# Error Reporting
NEXT_PUBLIC_ERROR_REPORTING_EMAIL=admin@yourcompany.com

# Server-Side Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000
DATA_TABLE_PAGE_SIZE=100
EXPORT_PAGE_SIZE=1000
VIRTUAL_SCROLL_THRESHOLD=500
ENABLE_VIRTUAL_SCROLLING=true

# Nginx / SSL Configuration
# Your domain name (used for SSL certificate)
DOMAIN=your-domain.com
# Email for Let's Encrypt SSL certificate notifications
SSL_EMAIL=admin@yourcompany.com
