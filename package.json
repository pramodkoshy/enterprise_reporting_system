    "@types/lodash": "^4.17.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^8.57.0",
