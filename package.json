{
  "name": "enterprise-reporting-system",
  "version": "1.0.0",
  "description": "Enterprise Reporting and Dashboard System with TanStack + Knex.js + shadcn/ui - Powered by Bun",
  "private": true,
  "scripts": {
    "dev": "bun run --watch next dev -p 4050",
    "build": "bun run next build",
    "build:migrations": "bun build src/lib/db/migrations/*.ts --outdir dist/migrations --target bun && echo 'Migrations compiled'",
    "build:seeds": "bun build src/lib/db/seeds/*.ts --outdir dist/seeds --target bun && echo 'Seeds compiled'",
    "build:check": "bun run lint && bun run typecheck && bun run build",
    "start": "bun run next start -p 4050",
    "lint": "bun run next lint",
    "lint:fix": "bun run next lint --fix",
    "db:migrate": "bunx knex migrate:latest --knexfile src/lib/db/knexfile.ts",
    "db:migrate:make": "bunx knex migrate:make --knexfile src/lib/db/knexfile.ts",
    "db:seed": "bunx knex seed:run --knexfile src/lib/db/knexfile.ts",
    "db:rollback": "bunx knex migrate:rollback --knexfile src/lib/db/knexfile.ts",
    "db:sample": "bun src/lib/db/sample-data/seed.ts",
    "jobs:worker": "bun src/lib/jobs/worker-runner.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:setup": "bun tests/setup-data.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:all": "bun run test:setup && bun run test:e2e",
    "test:ci": "bun run lint && bun run typecheck && bun run test:setup && bun run test:e2e",
    "test:watch": "playwright test --watch",
    "precommit": "bun run lint && bun run typecheck && bun run format:check",
    "test:phase1": "playwright test --grep '@batch1' --workers=1",
    "test:phase2": "playwright test --grep '@batch2' --workers=1",
    "test:phase3": "playwright test --grep '@batch3' --workers=1",
    "test:phase4": "playwright test --grep '@batch4' --workers=1",
    "test:phase5": "playwright test --grep '@batch5' --workers=1",
    "test:phase6": "playwright test --grep '@batch6' --workers=1",
    "test:batches": "for i in 1 2 3 4 5 6; do echo \"Running Phase $i...\" && bun run test:phase$i || exit 1; done",
    "test:app": "playwright test e2e/app.spec.ts --workers=1",
    "test:dashboard": "playwright test e2e/dashboards.spec.ts --workers=1",
    "test:sql": "playwright test e2e/sql-editor.spec.ts --workers=1",
    "test:reports": "playwright test e2e/reports.spec.ts --workers=1",
    "test:charts": "playwright test e2e/charts.spec.ts --workers=1",
    "test:granular-permissions": "playwright test e2e/granular-permissions.spec.ts --workers=1"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.29",
    "@auth/core": "^0.34.2",
    "@bull-board/api": "^6.16.2",
    "@bull-board/ui": "^6.16.2",
    "@copilotkit/react-core": "^1.51.4",
    "@copilotkit/react-ui": "^1.51.4",
